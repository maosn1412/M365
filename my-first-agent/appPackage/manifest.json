{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
    "manifestVersion": "1.30",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Mason",
        "websiteUrl": "https://github.com/",
        "privacyUrl": "https://github.com/",
        "termsOfUseUrl": "https://github.com/"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "my-first-agent${{APP_NAME_SUFFIX}}",
        "full": "My First Agent - M365 Learning Demo"
    },
    "description": {
        "short": "Declarative agent for learning M365 Agents Toolkit",
        "full": "A declarative agent created with Microsoft 365 Agents Toolkit for learning purposes. Demonstrates basic agent structure and validation."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": []
}